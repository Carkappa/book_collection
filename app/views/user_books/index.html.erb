<% content_for :title, "User Books" %>

<h1>User Books</h1>

<h1>You're logged in! Welcome to the Dashboard!</h1>
<%= link_to "Sign Out", destroy_admin_session_path %>

<div id="user_books">
  <% @user_books.each do |user_book| %>
    <%= render user_book %>
    <p>
      <%= link_to "Show this user book", user_book %>
    </p>
  <% end %>
</div>

<div>
  <%= link_to "Books", books_path %> |
  <%= link_to "Users", users_path %> |
  <%= link_to "New user book", new_user_book_path %>
</div>
