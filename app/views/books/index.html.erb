<% content_for :title, "Books" %>

<h1>Book Collection</h1>

<div id="books">
  <% if @books.any? %>
    <% @books.each do |book| %>
      <div>
        <%= render book %>
        <p>
          <%= link_to "Show", book %> |
          <%= link_to "Edit", edit_book_path(book) %> |
          <%= link_to "Delete", delete_book_path(book) %>
        </p>
      </div>
      <hr>
    <% end %>
  <% else %>
    <p>No books yet.</p>
  <% end %>
</div>

<div>
  <%= link_to "Add a new book", new_book_path %> |
  <%= link_to "Back to Home", root_path %>
</div>
