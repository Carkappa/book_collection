<% content_for :title, "Users" %>

<h1>Users</h1>

<div id="users">
  <% @users.each do |user| %>
    <%= render user %>
    <p>
      <%= link_to "Show this user", user %>
    </p>
  <% end %>
</div>

<div>
  <%= link_to "New user", new_user_path %> |
  <%= link_to "Back to User Books", root_path %>
</div>
